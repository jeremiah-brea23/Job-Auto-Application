# ─────────────────────────────────────────────────────────────
# Job Application AI System – environment variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Apify ────────────────────────────────────────────────────
# Your personal API token from https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# The dataset ID from your successful LinkedIn scraper run.
# Found in Apify Console → Storage → Datasets, or in the run detail page.
APIFY_DATASET_ID=your_dataset_id_here

# (Optional) The saved Task ID to trigger a new run instead of reading a fixed dataset.
# Found in Apify Console → Saved Tasks → your task → URL slug.
APIFY_TASK_ID=your_task_id_here

# ── Google Sheets ─────────────────────────────────────────────
# Path to your service-account JSON key file (see docs/SETUP_GOOGLE.md).
# Use a relative path from the project root, or an absolute path.
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json

# The spreadsheet ID from the URL of your tracking sheet:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Name of the worksheet tab to write jobs into (default: Jobs)
GOOGLE_WORKSHEET_NAME=Jobs

# Google Drive folder ID to upload cover letters into.
# Create a folder in Drive, share it with the service account email,
# then paste its ID here (from the folder URL).
# If blank, letters are uploaded to the service account root (less convenient).
GOOGLE_DRIVE_FOLDER_ID=

# ── AI (Phase 2+) ─────────────────────────────────────────────
# Model provider API key for fit assessment and cover-letter generation.
# Leave blank for Phase 1.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
